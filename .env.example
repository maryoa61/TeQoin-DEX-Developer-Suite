# ==========================================================
# Web Applet Environment Variables
# ==========================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==========================================================
# GitHub Actions Secrets (MultiSwapper Foundry Bot)
# Define these in your GitHub Repo: Settings -> Secrets and variables -> Actions
# ==========================================================
# RPC_URL: Network RPC endpoint (e.g. Robinhood / Sepolia / Arbitrum testnet RPC)
RPC_URL=

# TOKEN_A: Input token contract address (e.g. 0x...)
TOKEN_A=

# TOKEN_B: Output token contract address (e.g. 0x...)
TOKEN_B=

# ROUTER_ADDRESS: Uniswap V2 compatible router address (optional, has default fallback in script)
ROUTER_ADDRESS=0x77bF00A6A90c600f214b34BAFBB7918c0cF113A8

# KEY_1: Primary wallet private key (hex, 64 characters without or with 0x)
KEY_1=

# KEY_2: Optional secondary wallet private key
KEY_2=

# KEY_3: Optional third wallet private key
KEY_3=
